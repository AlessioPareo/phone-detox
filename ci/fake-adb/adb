#!/bin/sh
# A fake adb for the tests: a simulated phone whose data lives in $FAKE_PHONE.
# Handles only the commands used by this project's scripts.
S=$FAKE_PHONE
[ -n "$S" ] || { echo "FAKE_PHONE not set" >&2; exit 1; }
case "$1" in
  wait-for-device) exit 0 ;;
  devices) echo "List of devices attached"
    if [ "$2" = -l ]; then echo "FAKE123456             device usb:1-1 product:a54xnsxx model:SM_A546B device:a54x transport_id:1"
    else echo "FAKE123456	device"; fi; exit 0 ;;
  connect) echo "connected to $2"; exit 0 ;;
  -s) shift 2 ;;
esac
case "$1" in
  get-state) echo device ;;
  wait-for-device|reboot) ;;
  get-serialno) echo FAKE123456 ;;
  shell)
    shift
    cmd=$(printf '%s ' "$@" | sed "s|/data/local/tmp|$S/tmp|g")
    mkdir -p "$S/tmp"
    PATH="$(dirname "$0")/bin:$PATH" sh -c "$cmd"
    ;;
  *) echo "fake adb: unhandled command: $*" >&2; exit 1 ;;
esac
